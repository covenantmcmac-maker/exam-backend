# Base URL of the Exam Platform API.
#
# The app already defaults to the live backend, so you only need this file if
# you want to point somewhere else (e.g. a local server while developing).
#
# Live API (the default, no config needed):
#   EXPO_PUBLIC_API_URL=https://exam-backend-1-gbh3.onrender.com
#
# Local backend — note "localhost" means the phone itself on a device:
#   Browser / iOS simulator   EXPO_PUBLIC_API_URL=http://localhost:5000
#   Android emulator          EXPO_PUBLIC_API_URL=http://10.0.2.2:5000
#   Physical phone (same Wi-Fi) EXPO_PUBLIC_API_URL=http://192.168.1.100:5000
#
# Do NOT include a trailing /api — the app adds that itself.

EXPO_PUBLIC_API_URL=https://exam-backend-1-gbh3.onrender.com
