# Base URL of the Exam Platform API (this repository's Express server).
#
# Local web / iOS simulator:
#   EXPO_PUBLIC_API_URL=http://localhost:5000
#
# Android emulator (10.0.2.2 is the host machine from inside the emulator):
#   EXPO_PUBLIC_API_URL=http://10.0.2.2:5000
#
# Physical phone on the same Wi-Fi — use your computer's LAN IP:
#   EXPO_PUBLIC_API_URL=http://192.168.1.100:5000
#
# Production:
#   EXPO_PUBLIC_API_URL=https://your-api-host.example.com

EXPO_PUBLIC_API_URL=http://localhost:5000
