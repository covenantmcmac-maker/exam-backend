# ─── Exam Platform API ────────────────────────────────────────────────────────
# Copy to `.env` and fill in. Never commit `.env`.

# MongoDB connection string (required)
MONGODB_URI=mongodb://127.0.0.1:27017/exam-platform

# JWT secret used to sign login tokens (required)
JWT_SECRET=change-me-to-a-long-random-string

# Port the API listens on (default 5000)
# PORT=5000

# ─── Payments (Paystack) ─────────────────────────────────────────────────────
# Fees are charged in naira (NGN). Paystack handles the checkout.
#
# WITHOUT a secret key the API runs in DEV MODE: payments are created but not
# sent to Paystack, and POST /api/payments/:reference/dev-complete marks them
# paid so you can test the full flow. Dev mode is disabled as soon as a key is
# set (and never active when NODE_ENV=production).
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
# Public key — safe to expose, returned by GET /api/config.
PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxx
# Where the student's browser returns after paying on Paystack. Defaults to
# the hosted PWA: https://macmultimediaexams.netlify.app
# PAYMENT_CALLBACK_URL=https://your-app.example.com
# Currency for all fees (default NGN).
# PAYMENT_CURRENCY=NGN
# Pricing defaults (naira). Applied when an exam is created without explicit
# fees; admins/teachers can still set any amount per exam in the builder.
DEFAULT_ENTRY_FEE=300
DEFAULT_REVIEW_FEE=500
