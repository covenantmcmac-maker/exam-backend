{
  "name": "mac-multimedia-exams",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "^57.0.7",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-navigation/bottom-tabs": "^7.18.14",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.6",
    "expo": "~57.0.8",
    "expo-constants": "^57.0.7",
    "expo-document-picker": "~57.0.1",
    "expo-screen-capture": "~8.0.1",
    "expo-screen-capture": "~8.0.8",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-screens": "^4.26.2",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "~19.2.2",
    "jsdom": "^30.0.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "build:web": "expo export --platform web --output-dir dist",
    "build:web:mock": "EXPO_PUBLIC_API_URL=http://127.0.0.1:5099 expo export --platform web --output-dir /tmp/webpreview --clear",
    "mock:api": "node scripts/mock-server.js 5099",
    "test:api": "node scripts/smoke-test.mjs",
    "test:e2e": "node scripts/e2e-web.cjs",
    "test": "npm run typecheck && npm run test:api",
    "build:pwa": "expo export --platform web --output-dir dist --clear && node scripts/build-pwa.mjs dist",
    "build:pwa:mock": "EXPO_PUBLIC_API_URL=http://127.0.0.1:5099 expo export --platform web --output-dir /tmp/webpreview --clear && node scripts/build-pwa.mjs /tmp/webpreview",
    "serve:pwa": "node scripts/serve-pwa.mjs dist 8080",
    "test:pwa": "node scripts/test-pwa.mjs",
    "test:sw": "node scripts/test-sw-runtime.mjs",
    "test:pwa:ui": "node scripts/test-pwa-ui.cjs",
    "test:all": "npm run typecheck && npm run test:api && npm run build:pwa && npm run test:pwa && npm run test:sw && npm run build:pwa:mock && npm run test:e2e && npm run test:pwa:ui",
    "check:deploy": "node scripts/check-deploy.mjs"
  },
  "private": true
}
